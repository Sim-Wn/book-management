# 书易后端环境配置
# 复制为 server/.env 后按需修改；不提交到 Git

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=shuyi

# ---- 服务 ----
PORT=3000
# 生产环境必须改成随机长字符串（至少 32 位）
JWT_SECRET=please-change-me-to-a-random-secret

# 用户上架的书是否需要管理员审核后才出现在「在售」
# 1 = 需要审核（默认），0 = 发布即上架
BOOK_REVIEW=1

# 允许跨域访问后端的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
